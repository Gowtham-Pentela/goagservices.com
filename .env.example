# GoAG Website Environment Configuration

# Canonical Site URL (leave empty when deploying on GitHub Pages, set to https://goagservices.com on custom domain launch)
VITE_SITE_URL=

# Lead Form Submission Endpoint (Serverless API or mock)
VITE_FORM_ENDPOINT=https://api.goagservices.com/leads

# Search Engine Indexing: set to true to prevent indexing while testing on github.io, false on production domain
VITE_NOINDEX=true
